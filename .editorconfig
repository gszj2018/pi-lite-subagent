# EditorConfig: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

# Markdown: trailing whitespace is significant (hard line breaks, table alignment)
[*.md]
trim_trailing_whitespace = false

# Makefiles require tab indentation
[{Makefile,*.mk}]
indent_style = tab

# Windows batch files require CRLF line endings (special case: LF is used everywhere else)
[*.{bat,cmd}]
end_of_line = crlf
